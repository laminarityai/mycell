{
  "name": "app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "boundaries": "depcruise src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.11",
    "@nangohq/frontend": "0.71.13",
    "better-auth": "1.7.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "msw": "3.0.3",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "~5.0.5"
  }
}
