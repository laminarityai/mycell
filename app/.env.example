# Copy to .env. Matches the Postgres from `pnpm db:up`.
DATABASE_URL=postgres://mycel:mycel@localhost:5433/mycel

# Better Auth. Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# A Google OAuth client (type "Web application") with the redirect URI
# http://localhost:3000/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nango (connections to Google accounts), from the Nango environment's settings: an API key
# (Environment Settings > API Keys) and the webhook signing key (Environment Settings > Webhooks).
# docs/runbooks/m1-dogfood.md lists the key's scopes; `pnpm nango:preflight` checks both.
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
# Nango's API is https://api.nango.dev unless this says otherwise; only the e2e tests set it.
# NANGO_API_URL=

# Inngest (background jobs). Locally, run the dev server (`npx inngest-cli@latest dev -u
# http://localhost:3000/api/inngest`) and set INNGEST_DEV=1; it needs no keys. Against Inngest
# Cloud, leave INNGEST_DEV unset and fill in the event key, the signing key and the encryption
# key: the app key, from the KMS in production, that step state is encrypted with (ADR-0021).
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_ENCRYPTION_KEY=

# The Vercel AI Gateway (every model call), from the Vercel team's AI Gateway > API Keys.
AI_GATEWAY_API_KEY=
# The default model for each model role, as a gateway provider/model ID. An org's own row in
# model_roles wins over these. Keep Jev's version pinned for classify.
MODEL_CLASSIFY=typesafe-ai/jev-1.14.0
MODEL_FAST=openai/gpt-5-mini
MODEL_SMART=anthropic/claude-sonnet-4.5
MODEL_JUDGE=anthropic/claude-sonnet-4.5
# Optional: embed defaults to openai/text-embedding-3-small (1536-dimension vectors).
# MODEL_EMBED=openai/text-embedding-3-small
# Optional: the decision models, as comma-separated provider/model prefixes. A classify model
# that starts with one is asked through experimental_decide, any other through fast. Defaults to
# Jev and Laya.
# MODEL_DECISION_PREFIXES=typesafe-ai/jev,convaiinnovations/laya

# Credits: 1 credit is 1 cent of gateway cost, with no margin until M10, and the per-role
# estimate a call must find in the balance first (docs/credit-pricing.md has the working). The
# defaults in env.ts are the tests' old placeholders, so set these wherever the app runs.
CREDITS_PER_USD=100
CREDIT_ESTIMATE_CLASSIFY=1
CREDIT_ESTIMATE_FAST=2
CREDIT_ESTIMATE_SMART=25
CREDIT_ESTIMATE_JUDGE=5
CREDIT_ESTIMATE_EMBED=1

# The injection screen (Google Cloud Model Armor). Memory learns nothing without it: every item is
# skipped as unscreened. Optional, so local dev and CI start without Google Cloud. The template is
# its full resource name; turn on its prompt-injection and jailbreak filter and leave its logging
# off (docs/architecture.md, "Memory"). Mycel reaches it with no stored key, through Workload
# Identity Federation with the Vercel project's OIDC token (https://vercel.com/docs/oidc/gcp): the
# pool provider trusting that token and the service account (roles/modelarmor.user) it acts as.
# Locally, `vercel env pull` writes the VERCEL_OIDC_TOKEN it reads.
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/us/templates/<template>
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/vercel/providers/vercel
# GCP_SERVICE_ACCOUNT_EMAIL=mycel-screen@<project>.iam.gserviceaccount.com

# Gmail push (ADR-0026, docs/runbooks/deploy.md): Gmail tells Mycel about new mail within
# seconds instead of waiting for the minute poll. Gmail's watches publish to the Pub/Sub topic
# (its full name), and a push subscription posts each notification to /api/google/gmail-push,
# signed by the push service account for the audience, the route's full URL. Set all three or
# none. Unset, as locally, no watch starts, the route answers 404, and every app keeps polling
# every minute.
# GMAIL_PUSH_TOPIC=projects/<project>/topics/gmail-push
# GOOGLE_PUSH_AUDIENCE=https://<host>/api/google/gmail-push
# GOOGLE_PUSH_SERVICE_ACCOUNT=gmail-push-sender@<project>.iam.gserviceaccount.com

# Drive push (ADR-0026): each Drive's changes.watch channel posts to BETTER_AUTH_URL's
# /api/google/drive-push (which must be HTTPS) with a token signed with this secret, at least 32
# characters (`openssl rand -base64 32`). Unset, as locally, no channel opens, the route answers
# 404, and Drive keeps polling every minute. With it and Gmail push both set, the sweep runs
# every 5 minutes instead of every minute.
# DRIVE_PUSH_SECRET=

# The key store (ADR-0020, ADR-0024): one AWS KMS key per company, made on first use under the
# alias alias/<KMS_ALIAS_PREFIX>/org/<org ID>, encrypts held sends, and a second, an HMAC key
# under alias/<KMS_ALIAS_PREFIX>/org/<org ID>/hash, hashes memory's do-not-learn list. The key
# store fails without KMS_REGION, so it's required unless INNGEST_DEV=1. The access key pair is
# an IAM user's whose policy allows kms:CreateKey, plus kms:CreateAlias, kms:DeleteAlias,
# kms:DescribeKey, kms:GenerateDataKey, kms:Decrypt, kms:GenerateMac and kms:ScheduleKeyDeletion
# on the keys it makes and the aliases under alias/<prefix>/org/. Leave the pair unset to use the AWS SDK's own credential
# chain (a role) instead. Give each environment (production, preview, a laptop) its own prefix
# or AWS account.
# KMS_REGION=us-east-1
# KMS_ACCESS_KEY_ID=
# KMS_SECRET_ACCESS_KEY=
# KMS_ALIAS_PREFIX=mycel
# A KMS other than AWS's regional endpoint, such as LocalStack (http://localhost:4566).
# KMS_ENDPOINT=
