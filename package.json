{
  "name": "mycel",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build && pnpm e2e",
    "dev": "pnpm --filter app dev",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter app db:generate",
    "db:migrate": "pnpm --filter app db:migrate",
    "credits:grant": "pnpm --filter app credits:grant",
    "capability-requests": "pnpm --filter app capability-requests",
    "nango:preflight": "pnpm --filter app nango:preflight",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter app lint",
    "typecheck": "pnpm --filter app typecheck",
    "boundaries": "pnpm --filter app boundaries",
    "test": "pnpm --filter app test",
    "build": "pnpm --filter app build",
    "e2e": "pnpm --filter app e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
